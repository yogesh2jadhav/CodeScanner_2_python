# Environment overrides take precedence over config/config.yaml.
# Generic rule: CODEKNOWLEDGE_<SECTION>_<KEY>, e.g. CODEKNOWLEDGE_RETRIEVAL_GRAPH_MAX_DEPTH=4
CODEKNOWLEDGE_CONFIG=./config/config.yaml
CODEKNOWLEDGE_LLM_MODEL=qwen3:8b
CODEKNOWLEDGE_LLM_BASE_URL=http://localhost:11434
CODEKNOWLEDGE_OKF_SOURCE_DIR=./data/okf
CODEKNOWLEDGE_VECTOR_PERSIST_DIRECTORY=./data/indexes/vector
